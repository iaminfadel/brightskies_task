# BrightDrive compose overrides (#26). Copy to .env (compose reads it from
# the repo root automatically) or export in the shell; never edit config
# files in place. docker/deps.lock stays the pinned source of truth.

# --- images -----------------------------------------------------------------
# DEPS_IMAGE=ghcr.io/iaminfadel/brightdrive-deps@sha256:2633...
# CARLA_IMAGE=carlasim/carla:0.9.15@sha256:1af4...

# --- layout -----------------------------------------------------------------
# WS_DIR=/ws             # holds brightdrive/, install/, maps/, bags/, evidence/
# MAP_DIR=/ws/maps/current/town05-v14-pg
# CARLA_TOWN=Town05
# ROS_DOMAIN_ID=0

# --- runtime route ------------------------------------------------------------
# OBJECTS_FILE=/ws/brightdrive/config/validation/objects.json
# BRIDGE_FIXED_DELTA_SECONDS=0.1
# Param-file overrides: absolute paths INSIDE the container, e.g. files under
# $WS_DIR/config-override/ (visible at /ws/config-override via the mount).
# KISS_PARAMS=/ws/config-override/kiss_icp.yaml
# EKF_PARAMS=/ws/config-override/ekf.yaml
# LOCALIZATION_PARAMS=/ws/config-override/localization.yaml
# MAP_SERVER_PARAMS=/ws/config-override/map_server.yaml

# --- map server (#33, ADR 0003) ------------------------------------------------
# Serving knobs for the tiled map_server; the tile grid itself is fixed by
# build_map.py and is not a serving knob.
# MAP_SERVER_MODE=auto                   # full | windowed | auto
# MAP_SERVER_LIDAR_RANGE_M=50.0          # R_load = lidar_range + margin
# MAP_SERVER_MARGIN_M=10.0
# MAP_SERVER_HYSTERSIS_M=15.0            # R_evict = R_load + hysteresis
# MAP_SERVER_VOXEL_M=0.0                 # 0 keeps the builder's downsample
# MAP_SERVER_PUBLISH_HZ=0.0              # 0 publishes on serving-set change
# MAP_SERVER_POSE_STALE_S=2.0            # stale /localization/pose -> full map
# MAP_SERVER_INITIAL_X=0.0               # auto-mode seed until a pose arrives
# MAP_SERVER_INITIAL_Y=0.0

# --- test route ---------------------------------------------------------------
# EVIDENCE=/ws/evidence/compose-smoke

# --- eval route ---------------------------------------------------------------
# METRICS_FILE=/ws/evidence/metrics.json

# --- mapping route ------------------------------------------------------------
# MAP_BAG=/ws/bags/map_full5            # recorder DELETES this path first
# MAP_EVAL_BAG=/ws/bags/map_full5_eval
# MAP_DRIVE_SECONDS=900
# MAP_ID=town05-compose
# MAP_SPAWN=-164.732162,-95.141876,0.300000,-179.913696
# MAP_BUILDER_FLAGS=--pose-graph
