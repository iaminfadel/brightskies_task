<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>brightdrive_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, URDF, and tuned configs for the BrightDrive stack.</description>
  <maintainer email="aminfadel2004@gmail.com">BrightDrive</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>kiss_icp</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>brightdrive_localization</exec_depend>
  <exec_depend>brightdrive_interfaces</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
