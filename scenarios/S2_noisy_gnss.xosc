  <Story name="Drive">
    <Act name="DriveAct">
      <ManeuverGroup name="HeroManeuvers" maximumExecutionCount="1">
        <Actors selectTriggeringEntities="false">
          <EntityRef entityRef="hero"/>
        </Actors>
        <Maneuver name="FollowMappedRoute">
          <Event name="SetTargetSpeed" priority="overwrite">
            <Action name="SetTargetSpeedAction">
              <PrivateAction>
                <LongitudinalAction>
                  <SpeedAction>
                    <SpeedActionDynamics dynamicsShape="step" value="1" dynamicsDimension="time"/>
                    <SpeedActionTarget>
                      <AbsoluteTargetSpeed value="8.33"/>
                    </SpeedActionTarget>
                  </SpeedAction>
                </LongitudinalAction>
              </PrivateAction>
            </Action>
            <StartTrigger>
                <ConditionGroup>
                  <Condition name="StartNow" delay="0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0" rule="equalTo"/>
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
            </StartTrigger>
          </Event>
        </Maneuver>
      </ManeuverGroup>
      <StartTrigger>
                <ConditionGroup>
                  <Condition name="ActStart" delay="0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0" rule="equalTo"/>
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
      </StartTrigger>
      <StopTrigger>
        <ConditionGroup>
          <Condition name="RouteCovered" delay="0" conditionEdge="rising">
            <ByEntityCondition>
              <TriggeringEntities triggeringEntitiesRule="any">
                <EntityRef entityRef="hero"/>
              </TriggeringEntities>
              <EntityCondition>
                <TraveledDistanceCondition value="290.0"/>
              </EntityCondition>
            </ByEntityCondition>
          </Condition>
          <Condition name="TimeCap" delay="0" conditionEdge="rising">
            <ByValueCondition>
              <SimulationTimeCondition value="120" rule="greaterThan"/>
            </ByValueCondition>
          </Condition>
        </ConditionGroup>
      </StopTrigger>
    </Act>
