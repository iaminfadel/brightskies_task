                <Waypoint routeStrategy="fastest"><Position><WorldPosition x="28.07" y="-118.76" z="0.00"/></Position></Waypoint>
                <Waypoint routeStrategy="fastest"><Position><WorldPosition x="28.06" y="-122.76" z="0.00"/></Position></Waypoint>
                <Waypoint routeStrategy="fastest"><Position><WorldPosition x="28.06" y="-126.77" z="-0.00"/></Position></Waypoint>
                <Waypoint routeStrategy="fastest"><Position><WorldPosition x="28.05" y="-130.77" z="0.00"/></Position></Waypoint>
                <Waypoint routeStrategy="fastest"><Position><WorldPosition x="28.06" y="-134.77" z="0.00"/></Position></Waypoint>
                <Waypoint routeStrategy="fastest"><Position><WorldPosition x="28.06" y="-138.78" z="0.00"/></Position></Waypoint>
                <Waypoint routeStrategy="fastest"><Position><WorldPosition x="28.05" y="-142.78" z="0.00"/></Position></Waypoint>
                <Waypoint routeStrategy="fastest"><Position><WorldPosition x="28.05" y="-146.78" z="0.00"/></Position></Waypoint>
                <Waypoint routeStrategy="fastest"><Position><WorldPosition x="28.05" y="-148.78" z="0.00"/></Position></Waypoint>
              </Route>
              </AssignRouteAction>
            </RoutingAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
  <Story name="Drive">
    <Act name="DriveAct">
      <ManeuverGroup name="HeroManeuvers" maximumExecutionCount="1">
        <Actors selectTriggeringEntities="false">
          <EntityRef entityRef="hero"/>
        </Actors>
        <Maneuver name="FollowMappedRoute">
          <Event name="SetTargetSpeed" priority="overwrite">
            <Action name="SetTargetSpeedAction">
              <PrivateAction>
                <LongitudinalAction>
                  <SpeedAction>
                    <SpeedActionDynamics dynamicsShape="step" value="1" dynamicsDimension="time"/>
                    <SpeedActionTarget>
                      <AbsoluteTargetSpeed value="8.33"/>
                    </SpeedActionTarget>
                  </SpeedAction>
                </LongitudinalAction>
              </PrivateAction>
            </Action>
            <StartTrigger>
                <ConditionGroup>
                  <Condition name="StartNow" delay="0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0" rule="equalTo"/>
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
            </StartTrigger>
          </Event>
        </Maneuver>
      </ManeuverGroup>
      <StartTrigger>
                <ConditionGroup>
                  <Condition name="ActStart" delay="0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0" rule="equalTo"/>
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
      </StartTrigger>
      <StopTrigger>
        <ConditionGroup>
          <Condition name="RouteCovered" delay="0" conditionEdge="rising">
            <ByEntityCondition>
              <TriggeringEntities triggeringEntitiesRule="any">
                <EntityRef entityRef="hero"/>
              </TriggeringEntities>
              <EntityCondition>
                <TraveledDistanceCondition value="740.0"/>
              </EntityCondition>
            </ByEntityCondition>
          </Condition>
          <Condition name="TimeCap" delay="0" conditionEdge="rising">
            <ByValueCondition>
              <SimulationTimeCondition value="240" rule="greaterThan"/>
            </ByValueCondition>
          </Condition>
        </ConditionGroup>
      </StopTrigger>
    </Act>
  </Story>
  <StopTrigger>
    <ConditionGroup>
        <Condition name="criteria_CollisionTest" delay="0" conditionEdge="rising">
          <ByValueCondition>
            <ParameterCondition parameterRef="" value="" rule="lessThan"/>
          </ByValueCondition>
        </Condition>
    </ConditionGroup>
  </StopTrigger>
  </Storyboard>
</OpenSCENARIO>
