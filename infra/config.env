# Shared configuration for the BrightDrive GCP runtime.
# Override any value by exporting it before sourcing this file.
export PROJECT_ID="${PROJECT_ID:-project-e038f785-ff95-4654-ba6}"
export PROJECT_NUMBER="${PROJECT_NUMBER:-330586358676}"
export REGION="${REGION:-europe-west4}"
export ZONE="${ZONE:-europe-west4-a}"
export VM_NAME="${VM_NAME:-brightdrive-vm}"
export MACHINE_TYPE="${MACHINE_TYPE:-n1-standard-8}"
export GPU_TYPE="${GPU_TYPE:-nvidia-tesla-t4}"
export BOOT_DISK_SIZE="${BOOT_DISK_SIZE:-100GB}"
export NETWORK="${NETWORK:-brightskies-vpc}"
export SUBNET="${SUBNET:-brightskies-europe-west4}"
export SUBNET_RANGE="${SUBNET_RANGE:-10.164.0.0/20}"
export BUCKET="${BUCKET:-brightskies-artifacts-330586358676}"
export CI_SA="${CI_SA:-brightskies-ci@${PROJECT_ID}.iam.gserviceaccount.com}"
export VM_SA="${VM_SA:-brightskies-vm@${PROJECT_ID}.iam.gserviceaccount.com}"
export WIF_POOL="${WIF_POOL:-github}"
export WIF_PROVIDER="${WIF_PROVIDER:-github-oidc}"
export REPO="${REPO:-iaminfadel/brightskies_task}"
export BILLING_ACCOUNT="${BILLING_ACCOUNT:-0138A2-2894CC-39F651}"
# The billing account currency is CAD; these are the USD targets rounded up.
export BUDGET_ALERT_CAD="${BUDGET_ALERT_CAD:-35}"
export BUDGET_CAP_CAD="${BUDGET_CAP_CAD:-140}"
export MAX_RUN_DURATION="${MAX_RUN_DURATION:-4h}"
export PREEMPTION_NOTICE="${PREEMPTION_NOTICE:-120s}"
export IDLE_STOP_MINUTES="${IDLE_STOP_MINUTES:-30}"

# Fedora 43 ships Python 3.14, which the bundled gcloud 590 protobuf does not
# support; prefer the system 3.11 when present.
if [[ -x /usr/bin/python3.11 ]]; then
  export CLOUDSDK_PYTHON="${CLOUDSDK_PYTHON:-/usr/bin/python3.11}"
fi
